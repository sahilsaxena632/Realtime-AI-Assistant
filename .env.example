# ---------------------------------------------------------------------------
# Real-time AI Interview Assistant - environment variables
# Copy this file to .env and fill in your keys.
# ---------------------------------------------------------------------------

# Gemini Live (primary path) - free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Live API model (audio out + transcription). Older *-exp / *-live-001 are dead.
GEMINI_MODEL=models/gemini-3.1-flash-live-preview

# Which provider to start on: deepgram (fast text path, default) or gemini
PRIMARY_PROVIDER=deepgram

# Deepgram (fallback transcription) - free tier: https://console.deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# Fallback AI answer providers (need at least one)
DEFAULT_AI=groq

# Groq (fastest, free) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI ChatGPT (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Audio capture -----------------------------------------------------------
# Preferred: PulseAudio/PipeWire source NAMES (run: python3 main.py --list-devices).
# Captured as two separate streams so speakers are labeled deterministically:
#   MIC_SOURCE -> YOU         (your microphone)
#   SYS_SOURCE -> INTERVIEWER (the ".monitor" of your output sink = call audio)
# Leave both blank to auto-detect your defaults at launch. Capturing the monitor
# is non-destructive - you still hear the meeting normally.
MIC_SOURCE=
SYS_SOURCE=

# Fallback only: sounddevice indices (used if no source names / parec missing).
MIC_INDEX=
SYS_INDEX=

# Phone server secret key (auto-generated on first run if left blank)
SERVER_KEY=
